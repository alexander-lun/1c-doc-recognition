// BSLLS:CommonModuleMissingAPI-off - заимствованный модуль только перехватывает метод конфигурации

#Область СлужебныеПроцедурыИФункции

// Настройки расширения (константы с префиксом рд_) устанавливаются здесь,
// остальные передаются в исходный метод конфигурации.
//
// Параметры:
//  Настройки - Соответствие из КлючИЗначение - имя константы и значение строкой.
//
// Возвращаемое значение:
//  Массив из Строка - см. НастройкиОбменаВызовСервера.УстановитьНастройки.
//
&Вместо("УстановитьНастройки")
Функция рд_УстановитьНастройки(Настройки)

	Остальные = Новый Соответствие;

	Для Каждого КлючИЗначение Из Настройки Цикл
		Если СтрНачинаетсяС(КлючИЗначение.Ключ, "рд_")
			И Метаданные.Константы.Найти(КлючИЗначение.Ключ) <> Неопределено Тогда
			Константы[КлючИЗначение.Ключ].Установить(КлючИЗначение.Значение);
		Иначе
			Остальные.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат ПродолжитьВызов(Остальные);

КонецФункции

#КонецОбласти

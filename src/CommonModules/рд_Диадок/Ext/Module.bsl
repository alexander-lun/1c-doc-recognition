#Область ПрограммныйИнтерфейс

// Загружает из Диадока входящие УПД и создает по ним черновики поступления.
// Список документов читается постранично (GetDocuments), содержимое - методом GetEntityContent.
// Уже загруженные документы (регистр рд_ДокументыЭДО) пропускаются, поэтому загрузку можно
// запускать сколько угодно раз. Отметка «загружено по» (IndexKey) сдвигается только до первого
// документа с ошибкой, чтобы он попал в следующую загрузку.
//
// Возвращаемое значение:
//  Структура:
//   * Загружено - Число - создано черновиков.
//   * Пропущено - Число - документы, загруженные раньше.
//   * Документы - Массив из ДокументСсылка.ПоступлениеТоваров - созданные черновики.
//   * Ошибки - Массив из Строка
//
Функция ЗагрузитьВходящиеУПД() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Загружено", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("Документы", Новый Массив);
	Результат.Вставить("Ошибки", Новый Массив);

	Попытка
		ЗагрузитьДокументы(Результат);
	Исключение
		Результат.Ошибки.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Обработчик регламентного задания рд_ЗагрузкаИзДиадок.
//
Процедура ЗагрузкаИзДиадокРегламент() Экспорт

	Результат = ЗагрузитьВходящиеУПД();
	Если Результат.Ошибки.Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Загрузка из Диадока'"), УровеньЖурналаРегистрации.Ошибка, , ,
			СтрСоединить(Результат.Ошибки, Символы.ПС));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗагрузитьДокументы(Результат)

	Подключение = НастройкиПодключения();
	ЗагруженоПо = Константы.рд_ДиадокЗагруженоПо.Получить();
	БылаОшибка = Ложь;

	Пока Истина Цикл

		Страница = СписокДокументов(Подключение, ЗагруженоПо);
		ОписанияДокументов = РаботаСJSON.Свойство(Страница, "Documents", Новый Массив);

		Для Каждого ОписаниеДокумента Из ОписанияДокументов Цикл

			Попытка
				ЗагрузитьДокумент(Подключение, ОписаниеДокумента, Результат);
			Исключение
				Результат.Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Документ %1 от %2: %3'"),
					РаботаСJSON.Свойство(ОписаниеДокумента, "DocumentNumber", ""),
					РаботаСJSON.Свойство(ОписаниеДокумента, "DocumentDate", ""),
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
				БылаОшибка = Истина;
			КонецПопытки;

			Если Не БылаОшибка Тогда
				Константы.рд_ДиадокЗагруженоПо.Установить(РаботаСJSON.Свойство(ОписаниеДокумента, "IndexKey", ""));
			КонецЕсли;

		КонецЦикла;

		Если ОписанияДокументов.Количество() = 0 Или Не РаботаСJSON.Свойство(Страница, "HasMoreResults", Ложь) Тогда
			Прервать;
		КонецЕсли;
		ЗагруженоПо = РаботаСJSON.Свойство(ОписанияДокументов[ОписанияДокументов.ВГраница()], "IndexKey", "");

	КонецЦикла;

КонецПроцедуры

Процедура ЗагрузитьДокумент(Подключение, ОписаниеДокумента, Результат)

	ИдентификаторСообщения = РаботаСJSON.Свойство(ОписаниеДокумента, "MessageId", "");
	ИдентификаторСущности = РаботаСJSON.Свойство(ОписаниеДокумента, "EntityId", "");

	Если ЗагруженныйДокумент(ИдентификаторСущности) <> Неопределено Тогда
		Результат.Пропущено = Результат.Пропущено + 1;
		Возврат;
	КонецЕсли;

	Путь = СтрШаблон("/V4/GetEntityContent?boxId=%1&messageId=%2&entityId=%3",
		Кодировать(Подключение.Ящик), Кодировать(ИдентификаторСообщения), Кодировать(ИдентификаторСущности));
	Содержимое = ВыполнитьЗапрос(Подключение, Путь);

	ИмяФайла = РаботаСJSON.Свойство(ОписаниеДокумента, "FileName", "");
	Распознавание = рд_РаспознаваниеДокументов.РаспознатьИСоздатьПоступление(Содержимое,
		?(ПустаяСтрока(ИмяФайла), ИдентификаторСущности + ".xml", ИмяФайла));
	Если Не Распознавание.Успешно Тогда
		ВызватьИсключение СтрСоединить(Распознавание.Замечания, "; ");
	КонецЕсли;

	Запись = РегистрыСведений.рд_ДокументыЭДО.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторДокумента = ИдентификаторСущности;
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.Документ = Распознавание.Документ;
	Запись.ДатаЗагрузки = ТекущаяДатаСеанса();
	Запись.Записать();

	Результат.Загружено = Результат.Загружено + 1;
	Результат.Документы.Добавить(Распознавание.Документ);

КонецПроцедуры

Функция СписокДокументов(Подключение, ПослеКлюча)

	Путь = СтрШаблон("/V3/GetDocuments?boxId=%1&filterCategory=%2&count=100",
		Кодировать(Подключение.Ящик), "UniversalTransferDocument.Inbound");
	Если ЗначениеЗаполнено(ПослеКлюча) Тогда
		Путь = Путь + "&afterIndexKey=" + Кодировать(ПослеКлюча);
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Подключение, Путь);
	Возврат РаботаСJSON.ПрочитатьИзСтроки(ПолучитьСтрокуИзДвоичныхДанных(Ответ, КодировкаТекста.UTF8));

КонецФункции

Функция ЗагруженныйДокумент(ИдентификаторСущности)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументыЭДО.Документ КАК Документ
	|ИЗ
	|	РегистрСведений.рд_ДокументыЭДО КАК ДокументыЭДО
	|ГДЕ
	|	ДокументыЭДО.ИдентификаторДокумента = &ИдентификаторДокумента";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторСущности);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Документ, Неопределено);

КонецФункции

#Область HTTP

// Параметры подключения к API Диадока. Токен доступа выдает Контур.ID (OAuth 2.0);
// получение и обновление токена выполняется вне этого модуля, сюда он попадает через константу.
//
// Возвращаемое значение:
//  Структура:
//   * Адрес - Строка
//   * Токен - Строка
//   * Ящик - Строка - идентификатор ящика организации (boxId).
//
Функция НастройкиПодключения()

	Подключение = Новый Структура;
	Подключение.Вставить("Адрес", рд_РаспознаваниеДокументов.Настройка("рд_АдресДиадок"));
	Подключение.Вставить("Токен", рд_РаспознаваниеДокументов.Настройка("рд_ТокенДиадок"));
	Подключение.Вставить("Ящик", рд_РаспознаваниеДокументов.Настройка("рд_ЯщикДиадок"));

	Возврат Подключение;

КонецФункции

// Параметры:
//  Подключение - Структура - см. НастройкиПодключения.
//  Путь - Строка - путь и параметры запроса.
//
// Возвращаемое значение:
//  ДвоичныеДанные - тело ответа.
//
Функция ВыполнитьЗапрос(Подключение, Путь)

	Части = рд_РаспознаваниеДокументов.РазобратьАдрес(Подключение.Адрес);

	Запрос = Новый HTTPЗапрос(Части.Путь + Путь);
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + Подключение.Токен);
	Запрос.Заголовки.Вставить("Accept", "application/json");

	ЗащищенноеСоединение = ?(Части.Защищенное, Новый ЗащищенноеСоединениеOpenSSL, Неопределено);
	Соединение = Новый HTTPСоединение(Части.Сервер, Части.Порт, , , , ТаймаутЗапроса(), ЗащищенноеСоединение);
	Попытка
		Ответ = Соединение.Получить(Запрос);
	Исключение
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Диадок (%1) недоступен: %2'"),
			Подключение.Адрес, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Диадок: HTTP %1 %2'"),
			Ответ.КодСостояния, Лев(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), 500));
	КонецЕсли;

	Возврат Ответ.ПолучитьТелоКакДвоичныеДанные();

КонецФункции

Функция Кодировать(Значение)

	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);

КонецФункции

Функция ТаймаутЗапроса()

	Возврат 60;

КонецФункции

#КонецОбласти

#КонецОбласти

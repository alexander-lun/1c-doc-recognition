#Область ПрограммныйИнтерфейс

// Распознает документ поставщика и создает по нему черновик поступления.
// Документ не проводится: его проверяет и проводит пользователь.
//
// Параметры:
//  ДанныеФайла - ДвоичныеДанные - PDF или изображение.
//  ИмяФайла - Строка - для журнала.
//
// Возвращаемое значение:
//  Структура:
//   * Успешно - Булево - документ создан.
//   * Документ - ДокументСсылка.ПоступлениеТоваров, Неопределено
//   * Реквизиты - Соответствие, Неопределено - распознанные реквизиты после проверки.
//   * Замечания - Массив из Строка - что нужно проверить вручную.
//   * СпособИзвлечения - Строка - "pdf-text" или "ocr".
//   * Длительность - Число - мс.
//
Функция РаспознатьИСоздатьПоступление(ДанныеФайла, ИмяФайла = "") Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Документ", Неопределено);
	Результат.Вставить("Реквизиты", Неопределено);
	Результат.Вставить("Замечания", Новый Массив);
	Результат.Вставить("СпособИзвлечения", "");
	Результат.Вставить("Длительность", 0);

	ОтветМодели = "";
	Попытка
		Извлечение = ИзвлечьТекст(ДанныеФайла);
		Результат.СпособИзвлечения = Извлечение.Способ;

		ОтветМодели = ЗапроситьРеквизиты(Извлечение.Текст);
		Реквизиты = РаботаСJSON.ПрочитатьИзСтроки(ОтветМодели);
		Если ТипЗнч(Реквизиты) <> Тип("Соответствие") Тогда
			ВызватьИсключение НСтр("ru = 'Модель вернула не объект JSON'");
		КонецЕсли;

		ПроверитьРеквизиты(Реквизиты, Результат.Замечания);
		Результат.Реквизиты = Реквизиты;
		Результат.Документ = СоздатьПоступление(Реквизиты, Результат.Замечания);
		Результат.Успешно = Истина;
	Исключение
		Результат.Замечания.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Результат.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	ЗаписатьВЖурнал(Результат, ИмяФайла, ОтветМодели);

	Возврат Результат;

КонецФункции

// Проверяет ИНН по контрольным цифрам.
//
// Параметры:
//  ИНН - Строка - 10 цифр для организации, 12 для физического лица и ИП.
//
// Возвращаемое значение:
//  Булево
//
Функция ИННКорректен(ИНН) Экспорт

	Если Не (СтрДлина(ИНН) = 10 Или СтрДлина(ИНН) = 12) Или Не ТолькоЦифры(ИНН) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрДлина(ИНН) = 10 Тогда
		Возврат КонтрольнаяЦифраИНН(ИНН, "2,4,10,3,5,9,4,6,8") = Число(Сред(ИНН, 10, 1));
	КонецЕсли;

	Возврат КонтрольнаяЦифраИНН(ИНН, "7,2,4,10,3,5,9,4,6,8") = Число(Сред(ИНН, 11, 1))
		И КонтрольнаяЦифраИНН(ИНН, "3,7,2,4,10,3,5,9,4,6,8") = Число(Сред(ИНН, 12, 1));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИзвлечениеТекста

// Параметры:
//  ДанныеФайла - ДвоичныеДанные
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка
//   * Способ - Строка
//
Функция ИзвлечьТекст(ДанныеФайла)

	Ответ = ВыполнитьЗапрос(Настройка("рд_АдресСервисаИзвлеченияТекста"), "/extract", ДанныеФайла, 120);

	Текст = РаботаСJSON.Свойство(Ответ, "text", "");
	Если ПустаяСтрока(Текст) Тогда
		ВызватьИсключение НСтр("ru = 'В файле не найден текст'");
	КонецЕсли;

	Возврат Новый Структура("Текст, Способ", Текст, РаботаСJSON.Свойство(Ответ, "method", ""));

КонецФункции

#КонецОбласти

#Область ЗапросКМодели

// Параметры:
//  Текст - Строка - текст документа.
//
// Возвращаемое значение:
//  Строка - JSON с реквизитами по схеме СхемаРеквизитов.
//
Функция ЗапроситьРеквизиты(Текст)

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "system", ИнструкцияМодели()));
	Сообщения.Добавить(Новый Структура("role, content", "user", Лев(Текст, МаксимальнаяДлинаТекста())));

	Параметры = Новый Структура;
	Параметры.Вставить("temperature", 0);
	Параметры.Вставить("use_mmap", Истина);

	Тело = Новый Структура;
	Тело.Вставить("model", Настройка("рд_МодельLLM"));
	Тело.Вставить("messages", Сообщения);
	Тело.Вставить("format", РаботаСJSON.ПрочитатьИзСтроки(СхемаРеквизитов()));
	Тело.Вставить("stream", Ложь);
	Тело.Вставить("options", Параметры);
	Тело.Вставить("keep_alive", "2m");

	ТелоСтрокой = РаботаСJSON.ЗаписатьВСтроку(Тело);
	Ответ = ВыполнитьЗапрос(Настройка("рд_АдресСервисаLLM"), "/api/chat",
		ПолучитьДвоичныеДанныеИзСтроки(ТелоСтрокой, КодировкаТекста.UTF8, Ложь), 600);

	Возврат РаботаСJSON.Свойство(РаботаСJSON.Свойство(Ответ, "message"), "content", "");

КонецФункции

Функция ИнструкцияМодели()

	Возврат
	"Извлеки реквизиты из текста первичного документа поставщика (счет, УПД, товарная накладная).
	|Правила:
	|- seller - продавец (поставщик), buyer - покупатель.
	|- Числа без разделителей разрядов, десятичный разделитель - точка.
	|- Дата документа в формате YYYY-MM-DD.
	|- В items только строки товаров, без итоговых строк.
	|- amount строки - сумма строки с НДС.
	|- total - итог документа к оплате (""Всего к оплате"", ""Итого с НДС""), а не сумма НДС.
	|- Если реквизита в документе нет, верни пустую строку или 0. Ничего не придумывай.";

КонецФункции

Функция СхемаРеквизитов()

	Возврат
	"{
	|  ""type"": ""object"",
	|  ""properties"": {
	|    ""number"": {""type"": ""string""},
	|    ""date"": {""type"": ""string""},
	|    ""seller"": {""type"": ""object"", ""properties"": {
	|      ""name"": {""type"": ""string""}, ""inn"": {""type"": ""string""}, ""kpp"": {""type"": ""string""}},
	|      ""required"": [""name"", ""inn"", ""kpp""]},
	|    ""buyer"": {""type"": ""object"", ""properties"": {
	|      ""name"": {""type"": ""string""}, ""inn"": {""type"": ""string""}},
	|      ""required"": [""name"", ""inn""]},
	|    ""total"": {""type"": ""number""},
	|    ""items"": {""type"": ""array"", ""items"": {""type"": ""object"", ""properties"": {
	|      ""name"": {""type"": ""string""}, ""quantity"": {""type"": ""number""},
	|      ""unit"": {""type"": ""string""}, ""price"": {""type"": ""number""}, ""amount"": {""type"": ""number""}},
	|      ""required"": [""name"", ""quantity"", ""unit"", ""price"", ""amount""]}}
	|  },
	|  ""required"": [""number"", ""date"", ""seller"", ""buyer"", ""total"", ""items""]
	|}";

КонецФункции

Функция МаксимальнаяДлинаТекста()

	Возврат 12000;

КонецФункции

#КонецОбласти

#Область ПроверкаРеквизитов

// Проверяет распознанные реквизиты и исправляет то, что можно исправить однозначно.
// Модель может ошибиться в сумме строки; если количество × цена по всем строкам сходится с итогом,
// суммы строк пересчитываются.
//
// Параметры:
//  Реквизиты - Соответствие - ответ модели, изменяется.
//  Замечания - Массив из Строка - дополняется.
//
Процедура ПроверитьРеквизиты(Реквизиты, Замечания)

	ПроверитьИННПродавца(Реквизиты, Замечания);

	Если Не ЗначениеЗаполнено(РаботаСJSON.ДатаИзСтроки(РаботаСJSON.Свойство(Реквизиты, "date", ""))) Тогда
		Замечания.Добавить(НСтр("ru = 'Не распознана дата документа'"));
	КонецЕсли;

	Позиции = РаботаСJSON.Свойство(Реквизиты, "items", Новый Массив);
	Если Позиции.Количество() = 0 Тогда
		Замечания.Добавить(НСтр("ru = 'Не найдены строки товаров'"));
		Возврат;
	КонецЕсли;

	ИсправитьИтогРавныйНДС(Реквизиты, Позиции);
	Итог = ЧислоИлиНоль(РаботаСJSON.Свойство(Реквизиты, "total"));
	СуммаРасчетная = 0;
	СтрокиСРасхождением = Новый Массив;

	Для Индекс = 0 По Позиции.ВГраница() Цикл
		Позиция = Позиции[Индекс];
		Расчет = Окр(ЧислоИлиНоль(Позиция["quantity"]) * ЧислоИлиНоль(Позиция["price"]), 2);
		СуммаРасчетная = СуммаРасчетная + Расчет;
		Если Не СуммыРавны(Расчет, ЧислоИлиНоль(Позиция["amount"])) Тогда
			СтрокиСРасхождением.Добавить(Индекс);
		КонецЕсли;
	КонецЦикла;

	Если СтрокиСРасхождением.Количество() > 0 И СуммыРавны(СуммаРасчетная, Итог) Тогда
		НомераСтрок = Новый Массив;
		Для Каждого Индекс Из СтрокиСРасхождением Цикл
			Позиция = Позиции[Индекс];
			Позиция.Вставить("amount", Окр(ЧислоИлиНоль(Позиция["quantity"]) * ЧислоИлиНоль(Позиция["price"]), 2));
			НомераСтрок.Добавить(Формат(Индекс + 1, "ЧГ=0"));
		КонецЦикла;
		Реквизиты.Вставить("corrected_lines", СтрокиСРасхождением.Количество());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Распознавание документов'"), УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("Пересчитаны суммы строк %1 по количеству и цене", СтрСоединить(НомераСтрок, ", ")));
	Иначе
		Для Каждого Индекс Из СтрокиСРасхождением Цикл
			Замечания.Добавить(СтрШаблон(НСтр("ru = 'Строка %1: количество × цена не равно сумме'"), Индекс + 1));
		КонецЦикла;
	КонецЕсли;

	СуммаСтрок = 0;
	Для Каждого Позиция Из Позиции Цикл
		СуммаСтрок = СуммаСтрок + ЧислоИлиНоль(Позиция["amount"]);
	КонецЦикла;
	Если Не СуммыРавны(СуммаСтрок, Итог) Тогда
		Замечания.Добавить(СтрШаблон(НСтр("ru = 'Сумма строк %1 не совпадает с итогом документа %2'"),
			Формат(СуммаСтрок, "ЧДЦ=2; ЧГ=0"), Формат(Итог, "ЧДЦ=2; ЧГ=0")));
	КонецЕсли;

КонецПроцедуры

// Частая ошибка распознавания: в итог попадает строка "в том числе НДС".
// Если итог равен НДС 20% или 10% от суммы строк, итогом считается сумма строк.
//
// Параметры:
//  Реквизиты - Соответствие - изменяется.
//  Позиции - Массив из Соответствие
//
Процедура ИсправитьИтогРавныйНДС(Реквизиты, Позиции)

	СуммаСтрок = 0;
	Для Каждого Позиция Из Позиции Цикл
		СуммаСтрок = СуммаСтрок + ЧислоИлиНоль(Позиция["amount"]);
	КонецЦикла;
	Итог = ЧислоИлиНоль(РаботаСJSON.Свойство(Реквизиты, "total"));

	Если СуммыРавны(Итог, СуммаСтрок) Или Итог = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Ставка Из СтрРазделить("20,10", ",") Цикл
		НДС = Окр(СуммаСтрок * Число(Ставка) / (100 + Число(Ставка)), 2);
		Если СуммыРавны(Итог, НДС) Тогда
			Реквизиты.Вставить("total", СуммаСтрок);
			Реквизиты.Вставить("total_corrected", Истина);
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьИННПродавца(Реквизиты, Замечания)

	Продавец = РаботаСJSON.Свойство(Реквизиты, "seller", Новый Соответствие);
	ИННПродавца = СокрЛП(РаботаСJSON.Свойство(Продавец, "inn", ""));

	Если ПустаяСтрока(ИННПродавца) Тогда
		Замечания.Добавить(НСтр("ru = 'Не найден ИНН продавца'"));
		Возврат;
	КонецЕсли;

	Если Не ИННКорректен(ИННПродавца) Тогда
		Замечания.Добавить(СтрШаблон(НСтр("ru = 'ИНН продавца %1 не прошел проверку контрольных цифр'"), ИННПродавца));
	КонецЕсли;

КонецПроцедуры

Функция СуммыРавны(Сумма1, Сумма2)

	Возврат Макс(Сумма1 - Сумма2, Сумма2 - Сумма1) < ДопустимоеРасхождениеСумм();

КонецФункции

// Суммы считаются равными, если расходятся меньше чем на копейку.
//
// Возвращаемое значение:
//  Число
//
Функция ДопустимоеРасхождениеСумм()

	Возврат 0.01;

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

Функция ТолькоЦифры(Строка)

	Возврат СтрДлина(СтрСоединить(СтрРазделить(Строка, "0123456789"), "")) = 0;

КонецФункции

Функция КонтрольнаяЦифраИНН(ИНН, Коэффициенты)

	Сумма = 0;
	Позиция = 1;
	Для Каждого Коэффициент Из СтрРазделить(Коэффициенты, ",") Цикл
		Сумма = Сумма + Число(Коэффициент) * Число(Сред(ИНН, Позиция, 1));
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Сумма % 11 % 10;

КонецФункции

#КонецОбласти

#Область СозданиеДокумента

// Параметры:
//  Реквизиты - Соответствие - проверенные реквизиты.
//  Замечания - Массив из Строка - дополняется замечаниями по сопоставлению.
//
// Возвращаемое значение:
//  ДокументСсылка.ПоступлениеТоваров
//
Функция СоздатьПоступление(Реквизиты, Замечания)

	Поступление = Документы.ПоступлениеТоваров.СоздатьДокумент();
	Поступление.Дата = ТекущаяДатаСеанса();
	Поступление.рд_ВходящийНомер = СокрЛП(РаботаСJSON.Свойство(Реквизиты, "number", ""));
	Поступление.рд_ВходящаяДата = РаботаСJSON.ДатаИзСтроки(РаботаСJSON.Свойство(Реквизиты, "date", ""));
	Поступление.рд_СуммаДокумента = ЧислоИлиНоль(РаботаСJSON.Свойство(Реквизиты, "total"));
	Поступление.рд_Контрагент = Контрагент(РаботаСJSON.Свойство(Реквизиты, "seller", Новый Соответствие), Замечания);

	НомерСтроки = 0;
	Для Каждого Позиция Из РаботаСJSON.Свойство(Реквизиты, "items", Новый Массив) Цикл

		НомерСтроки = НомерСтроки + 1;
		НаименованиеПоставщика = СокрЛП(РаботаСJSON.Свойство(Позиция, "name", ""));

		СтрокаТоваров = Поступление.Товары.Добавить();
		СтрокаТоваров.Номенклатура = НоменклатураПоНаименованию(НаименованиеПоставщика);
		СтрокаТоваров.Количество = ЧислоИлиНоль(Позиция["quantity"]);
		СтрокаТоваров.рд_Цена = ЧислоИлиНоль(Позиция["price"]);
		СтрокаТоваров.рд_Сумма = ЧислоИлиНоль(Позиция["amount"]);
		СтрокаТоваров.рд_НаименованиеПоставщика = НаименованиеПоставщика;

		Если Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
			Замечания.Добавить(СтрШаблон(НСтр("ru = 'Строка %1: товар ""%2"" не сопоставлен с номенклатурой'"),
				НомерСтроки, НаименованиеПоставщика));
		КонецЕсли;

	КонецЦикла;

	Поступление.рд_ТребуетПроверки = Замечания.Количество() > 0;
	Поступление.рд_Замечания = СтрСоединить(Замечания, Символы.ПС);
	Поступление.Записать(РежимЗаписиДокумента.Запись);

	Возврат Поступление.Ссылка;

КонецФункции

// Ищет контрагента по ИНН; если не найден и ИНН корректен - создает.
//
// Параметры:
//  Продавец - Соответствие - name, inn, kpp.
//  Замечания - Массив из Строка
//
// Возвращаемое значение:
//  СправочникСсылка.рд_Контрагенты
//
Функция Контрагент(Продавец, Замечания)

	ИНН = СокрЛП(РаботаСJSON.Свойство(Продавец, "inn", ""));
	Если Не ИННКорректен(ИНН) Тогда
		Возврат Справочники.рд_Контрагенты.ПустаяСсылка();
	КонецЕсли;

	Найденный = Справочники.рд_Контрагенты.НайтиПоРеквизиту("ИНН", ИНН);
	Если ЗначениеЗаполнено(Найденный) Тогда
		Возврат Найденный;
	КонецЕсли;

	Наименование = СокрЛП(РаботаСJSON.Свойство(Продавец, "name", ""));

	НовыйКонтрагент = Справочники.рд_Контрагенты.СоздатьЭлемент();
	НовыйКонтрагент.Наименование = ?(ПустаяСтрока(Наименование), СтрШаблон(НСтр("ru = 'ИНН %1'"), ИНН), Наименование);
	НовыйКонтрагент.ИНН = ИНН;
	НовыйКонтрагент.КПП = Лев(СокрЛП(РаботаСJSON.Свойство(Продавец, "kpp", "")), 9);
	НовыйКонтрагент.Записать();

	Замечания.Добавить(СтрШаблон(НСтр("ru = 'Создан новый контрагент %1 (ИНН %2)'"), НовыйКонтрагент.Наименование, ИНН));
	Возврат НовыйКонтрагент.Ссылка;

КонецФункции

// Сопоставляет строку документа с номенклатурой: точное совпадение наименования,
// иначе - самая длинная номенклатура, наименование которой входит в наименование поставщика.
//
// Параметры:
//  НаименованиеПоставщика - Строка
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура
//
Функция НоменклатураПоНаименованию(НаименованиеПоставщика)

	Если ПустаяСтрока(НаименованиеПоставщика) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Товары.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Товары.Наименование = &Наименование
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ТочноеСовпадение,
	|	ДЛИНАСТРОКИ(Товары.Наименование) КАК Длина
	|ИЗ
	|	Справочник.Номенклатура КАК Товары
	|ГДЕ
	|	НЕ Товары.ПометкаУдаления
	|	И &Наименование ПОДОБНО ""%"" + Товары.Наименование + ""%""
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТочноеСовпадение УБЫВ,
	|	Длина УБЫВ";
	Запрос.УстановитьПараметр("Наименование", НаименованиеПоставщика);

	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.Номенклатура.ПустаяСсылка());

КонецФункции

#КонецОбласти

#Область HTTP

// Параметры:
//  Адрес - Строка - http://сервер:порт
//  Путь - Строка
//  Тело - ДвоичныеДанные
//  Таймаут - Число - секунды.
//
// Возвращаемое значение:
//  Соответствие - ответ сервиса.
//
Функция ВыполнитьЗапрос(Адрес, Путь, Тело, Таймаут)

	Части = РазобратьАдрес(Адрес);

	Запрос = Новый HTTPЗапрос(Части.Путь + Путь);
	Запрос.Заголовки.Вставить("Content-Type", "application/octet-stream");
	Запрос.УстановитьТелоИзДвоичныхДанных(Тело);

	ЗащищенноеСоединение = ?(Части.Защищенное, Новый ЗащищенноеСоединениеOpenSSL, Неопределено);
	Соединение = Новый HTTPСоединение(Части.Сервер, Части.Порт, , , , Таймаут, ЗащищенноеСоединение);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

	Если Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение СтрШаблон("%1%2: HTTP %3 %4", Адрес, Путь, Ответ.КодСостояния, Лев(ТекстОтвета, 500));
	КонецЕсли;

	Возврат РаботаСJSON.ПрочитатьИзСтроки(ТекстОтвета);

КонецФункции

// Параметры:
//  Адрес - Строка - http(s)://сервер[:порт][/путь]
//
// Возвращаемое значение:
//  Структура:
//   * Сервер - Строка
//   * Порт - Число
//   * Путь - Строка
//   * Защищенное - Булево
//
Функция РазобратьАдрес(Адрес)

	Части = Новый Структура;
	Части.Вставить("Сервер", "");
	Части.Вставить("Порт", 0);
	Части.Вставить("Путь", "");
	Части.Вставить("Защищенное", СтрНачинаетсяС(НРег(Адрес), "https://"));

	Остаток = Адрес;
	ПозицияСхемы = СтрНайти(Остаток, "://");
	Если ПозицияСхемы > 0 Тогда
		Остаток = Сред(Остаток, ПозицияСхемы + 3);
	КонецЕсли;

	ПозицияПути = СтрНайти(Остаток, "/");
	Если ПозицияПути > 0 Тогда
		Части.Путь = Сред(Остаток, ПозицияПути);
		Остаток = Лев(Остаток, ПозицияПути - 1);
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Части.Путь, "/") Цикл
		Части.Путь = Лев(Части.Путь, СтрДлина(Части.Путь) - 1);
	КонецЦикла;

	ПозицияПорта = СтрНайти(Остаток, ":");
	Если ПозицияПорта > 0 Тогда
		Части.Сервер = Лев(Остаток, ПозицияПорта - 1);
		Части.Порт = Число(Сред(Остаток, ПозицияПорта + 1));
	Иначе
		Части.Сервер = Остаток;
		Части.Порт = ?(Части.Защищенное, 443, 80);
	КонецЕсли;

	Возврат Части;

КонецФункции

#КонецОбласти

// Значение константы расширения или значение по умолчанию для локального стенда.
//
// Параметры:
//  Имя - Строка - имя константы.
//
// Возвращаемое значение:
//  Строка
//
Функция Настройка(Имя)

	Значение = СокрЛП(Константы[Имя].Получить());
	Если Не ПустаяСтрока(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	ПоУмолчанию = Новый Соответствие;
	ПоУмолчанию.Вставить("рд_АдресСервисаИзвлеченияТекста", "http://127.0.0.1:8091");
	ПоУмолчанию.Вставить("рд_АдресСервисаLLM", "http://127.0.0.1:11434");
	ПоУмолчанию.Вставить("рд_МодельLLM", "qwen2.5-coder:7b");

	Возврат ПоУмолчанию[Имя];

КонецФункции

Процедура ЗаписатьВЖурнал(Результат, ИмяФайла, ОтветМодели)

	Запись = РегистрыСведений.рд_ЖурналРаспознавания.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
	Запись.ИмяФайла = ИмяФайла;
	Запись.СпособИзвлечения = Результат.СпособИзвлечения;
	Запись.Модель = Настройка("рд_МодельLLM");
	Запись.Длительность = Результат.Длительность;
	Запись.Успешно = Результат.Успешно;
	Запись.Документ = Результат.Документ;
	Запись.Замечания = СтрСоединить(Результат.Замечания, Символы.ПС);
	Запись.ОтветМодели = ОтветМодели;
	Запись.Записать();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Признак того, что файл - XML (электронный документ), а не PDF или скан.
//
// Параметры:
//  ДанныеФайла - ДвоичныеДанные
//  ИмяФайла - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоXML(ДанныеФайла, ИмяФайла) Экспорт

	Если СтрЗаканчиваетсяНа(НРег(ИмяФайла), ".xml") Тогда
		Возврат Истина;
	КонецЕсли;

	// Начало файла: "<?xml", возможно после метки порядка байтов UTF-8.
	РазмерНачала = 8;
	Поток = ДанныеФайла.ОткрытьПотокДляЧтения();
	Буфер = Новый БуферДвоичныхДанных(РазмерНачала);
	Прочитано = Поток.Прочитать(Буфер, 0, РазмерНачала);
	Поток.Закрыть();

	Начало = ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер.Прочитать(0, Прочитано), КодировкаТекста.ANSI);
	Возврат СтрНайти(Начало, "<?xml") > 0;

КонецФункции

// Читает реквизиты УПД (счета-фактуры) в формате ФНС - так документ приходит по ЭДО (Диадок, СБИС).
// Поддерживаются форматы 5.03 (КНД 1115131) и 5.01 (КНД 1115125): они различаются именами
// атрибутов номера и даты документа.
//
// Параметры:
//  ДанныеФайла - ДвоичныеДанные - XML-файл УПД (обычно в кодировке windows-1251, она указана в заголовке XML).
//
// Возвращаемое значение:
//  Соответствие - реквизиты в том же виде, что и ответ модели при распознавании PDF:
//   number, date (ГГГГ-ММ-ДД), seller и buyer (name, inn, kpp), total,
//   items - Массив из Соответствие: name, code (код товара поставщика), unit, quantity, price, amount.
//   Цена строки - с НДС (стоимость с налогом / количество), как и в распознанных документах.
//
// Исключения:
//  Если файл не является УПД в формате ФНС.
//
Функция РеквизитыДокумента(ДанныеФайла) Экспорт

	ДокументDOM = ПрочитатьDOM(ДанныеФайла);

	Корень = ДокументDOM.ЭлементДокумента;
	Документ = ПервыйДочерний(Корень, "Документ");
	СвСчФакт = ПервыйДочерний(Документ, "СвСчФакт");
	Если Корень.ИмяУзла <> "Файл" Или СвСчФакт = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Файл не является УПД (счетом-фактурой) в формате ФНС'");
	КонецЕсли;

	Реквизиты = Новый Соответствие;
	Реквизиты.Вставить("number", ПервыйАтрибут(СвСчФакт, "НомерДок,НомерСчФ"));
	Реквизиты.Вставить("date", ДатаISO(ПервыйАтрибут(СвСчФакт, "ДатаДок,ДатаСчФ")));
	Реквизиты.Вставить("seller", Участник(ПервыйДочерний(СвСчФакт, "СвПрод")));
	Реквизиты.Вставить("buyer", Участник(ПервыйДочерний(СвСчФакт, "СвПокуп")));

	Таблица = ПервыйДочерний(Документ, "ТаблСчФакт");
	Позиции = Новый Массив;
	Если Таблица <> Неопределено Тогда
		Для Каждого СведТов Из ДочерниеЭлементы(Таблица, "СведТов") Цикл
			Позиции.Добавить(Позиция(СведТов));
		КонецЦикла;
	КонецЕсли;
	Реквизиты.Вставить("items", Позиции);

	ВсегоОпл = ?(Таблица = Неопределено, Неопределено, ПервыйДочерний(Таблица, "ВсегоОпл"));
	Реквизиты.Вставить("total", ?(ВсегоОпл = Неопределено, 0, ЧислоАтрибута(ВсегоОпл, "СтТовУчНалВсего")));

	Возврат Реквизиты;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьDOM(ДанныеФайла)

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьПоток(ДанныеФайла.ОткрытьПотокДляЧтения());
	Построитель = Новый ПостроительDOM;
	Попытка
		ДокументDOM = Построитель.Прочитать(Чтение);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Файл не является корректным XML: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Чтение.Закрыть();

	Возврат ДокументDOM;

КонецФункции

// Продавец или покупатель: организация (СвЮЛУч) или индивидуальный предприниматель (СвИП).
//
// Параметры:
//  Узел - ЭлементDOM, Неопределено - СвПрод или СвПокуп.
//
// Возвращаемое значение:
//  Соответствие - name, inn, kpp.
//
Функция Участник(Узел)

	Участник = Новый Соответствие;
	Участник.Вставить("name", "");
	Участник.Вставить("inn", "");
	Участник.Вставить("kpp", "");

	ИдСв = ПервыйДочерний(Узел, "ИдСв");
	Организация = ПервыйДочерний(ИдСв, "СвЮЛУч");
	Предприниматель = ПервыйДочерний(ИдСв, "СвИП");

	Если Организация <> Неопределено Тогда
		Участник.Вставить("name", ПервыйАтрибут(Организация, "НаимОрг"));
		Участник.Вставить("inn", ПервыйАтрибут(Организация, "ИННЮЛ"));
		Участник.Вставить("kpp", ПервыйАтрибут(Организация, "КПП"));
	ИначеЕсли Предприниматель <> Неопределено Тогда
		Участник.Вставить("inn", ПервыйАтрибут(Предприниматель, "ИННФЛ"));
		ФИО = ПервыйДочерний(Предприниматель, "ФИО");
		Если ФИО <> Неопределено Тогда
			Части = Новый Массив;
			Для Каждого Имя Из СтрРазделить("Фамилия,Имя,Отчество", ",") Цикл
				Значение = ПервыйАтрибут(ФИО, Имя);
				Если ЗначениеЗаполнено(Значение) Тогда
					Части.Добавить(Значение);
				КонецЕсли;
			КонецЦикла;
			Участник.Вставить("name", НСтр("ru = 'ИП'") + " " + СтрСоединить(Части, " "));
		КонецЕсли;
	Иначе
		// Иностранная организация (СвИнНеУч): ИНН нет, только наименование.
		Иностранная = ПервыйДочерний(ИдСв, "СвИнНеУч");
		Если Иностранная <> Неопределено Тогда
			Участник.Вставить("name", ПервыйАтрибут(Иностранная, "НаимОрг"));
		КонецЕсли;
	КонецЕсли;

	Возврат Участник;

КонецФункции

Функция Позиция(СведТов)

	Количество = ЧислоАтрибута(СведТов, "КолТов");
	Сумма = ЧислоАтрибута(СведТов, "СтТовУчНал");

	Позиция = Новый Соответствие;
	Позиция.Вставить("name", ПервыйАтрибут(СведТов, "НаимТов"));
	Позиция.Вставить("unit", ПервыйАтрибут(СведТов, "НаимЕдИзм,ОКЕИ_Тов"));
	Позиция.Вставить("quantity", Количество);
	Позиция.Вставить("price", ?(Количество = 0, 0, Сумма / Количество));
	Позиция.Вставить("amount", Сумма);

	ДопСведТов = ПервыйДочерний(СведТов, "ДопСведТов");
	Позиция.Вставить("code", ?(ДопСведТов = Неопределено, "", ПервыйАтрибут(ДопСведТов, "КодТов")));

	Возврат Позиция;

КонецФункции

Функция ПервыйДочерний(Узел, Имя)

	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Дочерний Из Узел.ДочерниеУзлы Цикл
		Если Дочерний.ТипУзла = ТипУзлаDOM.Элемент И Дочерний.ИмяУзла = Имя Тогда
			Возврат Дочерний;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ДочерниеЭлементы(Узел, Имя)

	Элементы = Новый Массив;
	Для Каждого Дочерний Из Узел.ДочерниеУзлы Цикл
		Если Дочерний.ТипУзла = ТипУзлаDOM.Элемент И Дочерний.ИмяУзла = Имя Тогда
			Элементы.Добавить(Дочерний);
		КонецЕсли;
	КонецЦикла;

	Возврат Элементы;

КонецФункции

// Значение первого из перечисленных атрибутов, который есть у элемента.
//
// Параметры:
//  Элемент - ЭлементDOM
//  Имена - Строка - имена атрибутов через запятую.
//
// Возвращаемое значение:
//  Строка
//
Функция ПервыйАтрибут(Элемент, Имена)

	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Если Элемент.ЕстьАтрибут(Имя) Тогда
			Возврат СокрЛП(Элемент.ПолучитьАтрибут(Имя));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЧислоАтрибута(Элемент, Имя)

	Значение = ПервыйАтрибут(Элемент, Имя);
	Возврат ?(ПустаяСтрока(Значение), 0, Число(Значение));

КонецФункции

// Дата из формата ФНС ДД.ММ.ГГГГ в ГГГГ-ММ-ДД.
//
// Параметры:
//  ДатаФНС - Строка
//
// Возвращаемое значение:
//  Строка - пустая, если дата не в формате ДД.ММ.ГГГГ.
//
Функция ДатаISO(ДатаФНС)

	Части = СтрРазделить(ДатаФНС, ".");
	Если Части.Количество() <> 3 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("%1-%2-%3", Части[2], Части[1], Части[0]);

КонецФункции

#КонецОбласти

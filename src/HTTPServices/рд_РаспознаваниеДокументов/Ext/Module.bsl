#Область ОбработчикиСобытий

Функция РаспознатьPOST(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка

		ДанныеФайла = Запрос.ПолучитьТелоКакДвоичныеДанные();
		Если ДанныеФайла.Размер() = 0 Тогда
			Возврат ОтветОшибка(400, НСтр("ru = 'Передайте файл в теле запроса'"));
		КонецЕсли;

		ИмяФайла = Запрос.ПараметрыЗапроса.Получить("filename");
		Результат = рд_РаспознаваниеДокументов.РаспознатьИСоздатьПоступление(ДанныеФайла,
			?(ИмяФайла = Неопределено, "", ИмяФайла));

		Ответ = Новый Структура;
		Ответ.Вставить("success", Результат.Успешно);
		Ответ.Вставить("needs_review", Результат.Замечания.Количество() > 0);
		Ответ.Вставить("notes", Результат.Замечания);
		Ответ.Вставить("extraction", Результат.СпособИзвлечения);
		Ответ.Вставить("duration_ms", Результат.Длительность);
		Ответ.Вставить("data", Результат.Реквизиты);
		Ответ.Вставить("document", ПредставлениеДокумента(Результат.Документ));

		Возврат ОтветJSON(?(Результат.Успешно, 201, 422), Ответ);

	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

Функция ЖурналGET(Запрос)

	ОтказВДоступе = ПроверитьДоступ(Запрос);
	Если ОтказВДоступе <> Неопределено Тогда
		Возврат ОтказВДоступе;
	КонецЕсли;

	Попытка

		Запрос1С = Новый Запрос;
		Запрос1С.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Журнал.Период КАК Период,
		|	Журнал.ИмяФайла КАК ИмяФайла,
		|	Журнал.СпособИзвлечения КАК СпособИзвлечения,
		|	Журнал.Модель КАК Модель,
		|	Журнал.Длительность КАК Длительность,
		|	Журнал.Успешно КАК Успешно,
		|	Журнал.Замечания КАК Замечания
		|ИЗ
		|	РегистрСведений.рд_ЖурналРаспознавания КАК Журнал
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";

		Записи = Новый Массив;
		Выборка = Запрос1С.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Запись = Новый Структура;
			Запись.Вставить("date", Выборка.Период);
			Запись.Вставить("file", Выборка.ИмяФайла);
			Запись.Вставить("extraction", Выборка.СпособИзвлечения);
			Запись.Вставить("model", Выборка.Модель);
			Запись.Вставить("duration_ms", Выборка.Длительность);
			Запись.Вставить("success", Выборка.Успешно);
			Запись.Вставить("notes", Выборка.Замечания);
			Записи.Добавить(Запись);
		КонецЦикла;

		Возврат ОтветJSON(200, Новый Структура("items", Записи));

	Исключение
		Возврат ВнутренняяОшибка(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредставлениеДокумента(Документ)

	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Поступление.Номер КАК Номер,
	|	Поступление.Дата КАК Дата,
	|	Поступление.Проведен КАК Проведен,
	|	Поступление.рд_ВходящийНомер КАК ВходящийНомер,
	|	Поступление.рд_ВходящаяДата КАК ВходящаяДата,
	|	Поступление.рд_СуммаДокумента КАК СуммаДокумента,
	|	Поступление.рд_ТребуетПроверки КАК ТребуетПроверки,
	|	Контрагенты.Наименование КАК Контрагент,
	|	Контрагенты.ИНН КАК ИНН
	|ИЗ
	|	Документ.ПоступлениеТоваров КАК Поступление
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.рд_Контрагенты КАК Контрагенты
	|		ПО Поступление.рд_Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	Поступление.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Документ);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Данные = Новый Структура;
	Данные.Вставить("number", Выборка.Номер);
	Данные.Вставить("date", Выборка.Дата);
	Данные.Вставить("posted", Выборка.Проведен);
	Данные.Вставить("incoming_number", Выборка.ВходящийНомер);
	Данные.Вставить("incoming_date", Выборка.ВходящаяДата);
	Данные.Вставить("amount", Выборка.СуммаДокумента);
	Данные.Вставить("needs_review", Выборка.ТребуетПроверки);
	Данные.Вставить("supplier", ?(Выборка.Контрагент = NULL, "", Выборка.Контрагент));
	Данные.Вставить("supplier_inn", ?(Выборка.ИНН = NULL, "", Выборка.ИНН));

	Возврат Данные;

КонецФункции

Функция ПроверитьДоступ(Запрос)

	Токен = СокрЛП(Константы.ТокенAPI.Получить());

	Ключ = "";
	Для Каждого КлючИЗначение Из Запрос.Заголовки Цикл
		Если НРег(КлючИЗначение.Ключ) = "x-api-key" Тогда
			Ключ = КлючИЗначение.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(Токен) Или Ключ <> Токен Тогда
		Возврат ОтветОшибка(401, НСтр("ru = 'Неверный или отсутствующий ключ API (заголовок X-Api-Key)'"));
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ОтветJSON(КодСостояния, Данные)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(РаботаСJSON.ЗаписатьВСтроку(Данные),
		КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Возврат Ответ;

КонецФункции

Функция ОтветОшибка(КодСостояния, Текст)

	Возврат ОтветJSON(КодСостояния, Новый Структура("error", Текст));

КонецФункции

Функция ВнутренняяОшибка(Информация)

	ЗаписьЖурналаРегистрации(НСтр("ru = 'Распознавание документов'"), УровеньЖурналаРегистрации.Ошибка, , ,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));

	Возврат ОтветОшибка(500, ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация));

КонецФункции

#КонецОбласти
